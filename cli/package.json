{
  "name": "zops",
  "version": "0.2.0",
  "description": "Agent-first CLI for the Zerops API — complete coverage of the public REST surface",
  "type": "module",
  "private": true,
  "bin": {
    "zops": "./src/index.ts"
  },
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "build": "bun build --compile --no-compile-autoload-dotenv --minify --outfile dist/zops src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
